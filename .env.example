# Copy to .env.local for local work. Never commit a filled-in copy —
# `*.local` is gitignored; this file is the documentation.
#
# On Vercel these are set in Project → Settings → Environment Variables,
# not in a file. See DEPLOY.md.

# REQUIRED. The API origin, including /api/v1. A production build refuses to
# start without it rather than shipping a site pointed at localhost.
#
# vite.config.js accepts the first of these it finds, so the name is negotiable
# if a host will not take a VITE_ prefix:
#   VITE_BASE_URL, VITE_API_BASE_URL, API_BASE_URL, BASE_URL
VITE_BASE_URL=http://localhost:8000/api/v1

# Optional. This site's own origin, for canonical URLs and JSON-LD (§14.3).
# Defaults to https://rajdhanifood.com.
# Also accepted as: SITE_URL
VITE_SITE_URL=http://localhost:5173

# Optional. The reCAPTCHA v3 *site* key — publishable by design (§14.2). Its
# secret counterpart belongs in backend/api/.env and must never appear here:
# every VITE_ variable is compiled verbatim into the public JavaScript bundle.
# Unset is fine; the forms work without it.
# VITE_RECAPTCHA_SITE_KEY=
